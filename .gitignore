# Entorno
.venv/
source/
__pycache__/
*.pyc

# PyInstaller: artefactos del build del .exe (el .spec SI se versiona)
build/
dist/

# macOS
.DS_Store

# Telemetria cruda: pesa mucho y siempre puedes volver a exportarla de
# Garage61. Las referencias procesadas (*.json) SI se versionan: son
# pequenas y son el resultado de tu trabajo de afinado.
*.csv
*.ibt

# Excepcion: los fixtures de los tests SI se versionan. Son copias congeladas
# de las dos vueltas con las que se valido el proyecto y sin ellas los tests de
# regresion no existen (353 KB comprimidos, no duelen).
!tests/data/*.csv

# Cache de pytest
.pytest_cache/
